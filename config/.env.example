# ── DISCORD ACCOUNT TOKENS ──────────────────────────────────────────────
# The rotation system runs ONE account at a time, switching every ~2-3h.
# Each persona needs its own user token. Set these in your real .env file:
#
#   DISCORD_TOKEN        -> Eudora's user token (REQUIRED, back-compat name)
#   DISCORD_TOKEN_ISLA   -> Isla's user token
#   DISCORD_TOKEN_ROWAN  -> Rowan's user token
#
# User token: open Discord in browser -> DevTools (F12) -> Network tab ->
# click any request -> look for the "authorization" header -> copy value.
# NEVER paste real tokens here or commit them — .env only.
DISCORD_TOKEN=your_user_token_here
#DISCORD_TOKEN_ISLA=your_isla_token_here
#DISCORD_TOKEN_ROWAN=your_rowan_token_here

# Persona rotation timing (minutes). Active window = ROTATE_MIN + random
# 0..JITTER_MIN. Defaults: ~2.5h + up to 30m jitter = a 2-3h human cadence.
# PERSONA_ROTATE_MIN=150
# PERSONA_ROTATE_JITTER_MIN=30

# ================== GROQ API KEYS ==================
# Get free API keys from https://console.groq.com
# IMPORTANT: Groq rate limits are per-ACCOUNT, not per-key.
# To get more capacity, create separate Groq accounts (different emails),
# each with their own API key.
#
# Free tier limits per account:
#   - gpt-oss-20b (complex replies): 200K tokens/day, 1K requests/day
#   - llama-3.1-8b (simple tasks): 500K tokens/day, 14.4K requests/day
#
# Recommended: 3+ accounts for smooth 24/7 operation
# With 10 accounts: ~2M tokens/day for replies, ~5M for simple tasks

GROQ_API_KEY=your_groq_key_here
# Add your additional keys below (uncomment and paste):
#GROQ_API_KEY_2=your_groq_key_2
#GROQ_API_KEY_3=your_groq_key_3
#GROQ_API_KEY_4=your_groq_key_4
#GROQ_API_KEY_5=your_groq_key_5
#GROQ_API_KEY_6=your_groq_key_6
#GROQ_API_KEY_7=your_groq_key_7
#GROQ_API_KEY_8=your_groq_key_8
#GROQ_API_KEY_9=your_groq_key_9
#GROQ_API_KEY_10=your_groq_key_10

# ================== CHANNEL CONFIGURATION ==================
# Right-click a channel in Discord -> Copy ID (requires Developer Mode:
# Settings -> Advanced -> Developer Mode)

# The channel where /bump slash command runs (usually #bump-bot, #commands, or #bump)
BUMP_CHANNEL_ID=1234567890123456789

# Text channels where the bot reads messages and replies.
# Comma-separated list of channel IDs. Add as many as you want.
# The bot will also discover and participate in other active channels automatically.
TEXT_CHANNEL_IDS=1234567890123456789

# ================== PING / ROLE CONFIGURATION ==================

# Chat revive ping role ID — the bot will ping this role when chat goes dead
# Format: just the role ID number (the bot will format it as <@&ID>)
# Right-click the role in Discord -> Copy ID (requires Developer Mode)
CHAT_REVIVE_PING_ROLE=1234567890123456789

# ================== BUMP SCHEDULER SETTINGS ==================

# Base interval between bump batches (in hours)
BUMP_BASE_INTERVAL_HOURS=2

# Random jitter added to the base interval (in hours)
# Actual interval = base + random(0, jitter) with beta distribution
BUMP_JITTER_HOURS=2

# ================== OWNERS ==================

# Comma-separated Discord user IDs with owner privileges (only owners can DM
# the bot; owners bypass certain pushback logic). Also gates the action
# worker's dangerous tools (DMs, slash commands, scheduling, profile edits).
# OWNER_IDS=1391457611618062376,1345822697078395032

# ================== ACTION WORKER ==================

# Outsider action engine — executes user requests the native command regexes
# don't cover (send/ping in other channels, gifs, reactions, slash cmds, VC
# ops). Runs silently (no confirmation messages) with a human-like delay.
# Set 0 to disable entirely (bot falls back to replying conversationally).
# ACTION_WORKER_ENABLED=1

# Seconds to wait before performing an action (human-like thinking delay).
# ACTION_DELAY_MIN=2.0
# ACTION_DELAY_MAX=6.0

# Hard timeout (seconds) for a single action request.
# ACTION_TIMEOUT_S=45

# Second-opinion LLM arbiters: (a) imperative check for exec actions and
# (b) info-question check for lookups. Set 0 to disable (not recommended —
# declarative messages mentioning actions could leak worker replies).
# ACTION_CONFIRM_LLM=1

# Optional: Klipy API key for GIF tools (search_gifs/send_gif). Without it
# those tools return an error and the agent replies text-only.
# KLIPY_API_KEY=

# ================== PROACTIVE MESSAGING SETTINGS ==================

# How many minutes of inactivity before a channel is considered "dead"
DEAD_CHAT_THRESHOLD_MIN=20

# How often to check for dead channels (in minutes)
PROACTIVE_CHECK_MIN=5

# Min and max minutes between proactive messages (sent to active channels)
PROACTIVE_MIN_MIN=40
PROACTIVE_MAX_MIN=80

# Chance of sending a random auto-chat message when chat is slowing down (0-1)
# Uses pre-written messages only (no AI calls, saves Groq tokens)
AUTO_CHAT_CHANCE=0.10

# ================== ENGAGEMENT / STALE-MESSAGE CLEANUP ==================

# Max unanswered engagement messages kept per channel before cleanup kicks in
# (soft cap — messages that got responses are never deleted)
ENGAGE_MAX_UNANSWERED=4

# Minutes before an unanswered engagement message counts as "stale"
ENGAGE_STALE_MINUTES=15

# Consecutive unanswered engagement cycles before the bot pauses a channel
# (it resumes automatically when humans talk again)
ENGAGE_PAUSE_AFTER_FAILS=3

# How long a channel pause lasts without human activity (minutes)
ENGAGE_PAUSE_MINUTES=120

# Max stale messages deleted per sweep (rate-limit friendly)
ENGAGE_MAX_DELETES=3

# Min minutes between ANY two engagement sends in a channel — shared across
# all senders (revive/auto-chat/post-bump/proactive/re-engage)
ENGAGE_MIN_GAP_MIN=8

# ================== PING CONTROLS ==================
# Hard limits below are enforced on EVERY ping path (revive / re-engage /
# action worker). On top of them: each ping nobody answers multiplies the
# cooldown, and 2 unanswered mass pings MUTE channel pings until a human
# speaks — a dead channel can never be spammed. Ping history is persisted
# to data/ping_state.json + mirrored to D1 (survives redeploys).

# @here pings: max per day per channel + cooldown minutes
PING_HERE_DAILY_LIMIT=3
PING_HERE_COOLDOWN_MIN=120

# @everyone pings: max per week per channel + cooldown hours (168 = weekly)
PING_EVERYONE_WEEKLY_LIMIT=1
PING_EVERYONE_COOLDOWN_HOURS=168

# Role pings (chat revive): cooldown minutes + daily cap
PING_ROLE_COOLDOWN_MIN=30
PING_ROLE_DAILY_LIMIT=4

# Direct user pings: cooldown minutes + total daily cap across all ping types
PING_USER_COOLDOWN_MIN=10
PING_TOTAL_DAILY_LIMIT=15

# Minutes a mass ping (@here/@everyone/role) must wait after ANY ping —
# stops different cooldown pools producing back-to-back pings
PING_MIN_MASS_GAP_MIN=20

# Fraction of random user pings aimed at ONLINE users (rest hit offline
# lurkers to pull them in). 0.40 = 40% online / 60% offline
PING_ONLINE_RATIO=0.40

# Hours before the same user can be pinged again for engagement
PING_REPEAT_COOLDOWN_HOURS=2

# ================== MEDIA ==================

# Base probability a reply is followed by a GIF / sticker
GIF_CHANCE=0.05
STICKER_CHANCE=0.08

# ================== WELCOME ==================

# Probability the bot skips greeting a new member entirely (humans don't
# greet every join)
WELCOME_SKIP_CHANCE=0.15

# ================== CLOUDFLARE D1 (Agent Cache) ==================
CF_D1_ACCOUNT_ID=your_account_id
CF_D1_DATABASE_ID=your_database_id
CF_D1_API_TOKEN=your_api_token

# ================== FISH AUDIO (Voice TTS) ==================
# Get API key from https://fish.audio → Settings → API Keys
# Get voice_id from your voice model page (the UUID in the URL)
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
# Per-persona voice overrides — each account should SOUND different.
# Falls back to FISH_AUDIO_VOICE_ID when unset (e.g. Rowan needs a male voice).
#FISH_AUDIO_VOICE_ID_ISLA=
#FISH_AUDIO_VOICE_ID_ROWAN=
